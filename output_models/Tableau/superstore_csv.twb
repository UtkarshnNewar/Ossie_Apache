      <column caption="Total Sales" datatype="real" name="[Total Sales]" role="measure" type="quantitative" default-format="$#,0.00">
        <calculation class="tableau" formula="SUM([Sales])"/>
      </column>
      <column caption="Total Profit" datatype="real" name="[Total Profit]" role="measure" type="quantitative" default-format="$#,0.00">
        <calculation class="tableau" formula="SUM([Profit])"/>
      </column>
      <column caption="Total Quantity" datatype="real" name="[Total Quantity]" role="measure" type="quantitative" default-format="#,0">
        <calculation class="tableau" formula="SUM([Quantity])"/>
      </column>
      <column caption="Order Count" datatype="integer" name="[Order Count]" role="measure" type="quantitative" default-format="#,0">
        <calculation class="tableau" formula="COUNTD([Order_ID])"/>
      </column>
      <column caption="Profit Margin" datatype="real" name="[Profit Margin]" role="measure" type="quantitative" default-format="0.0%">
        <calculation class="tableau" formula="[Total Profit] / ([Total Sales])"/>
      </column>
      <column caption="Avg Discount" datatype="real" name="[Avg Discount]" role="measure" type="quantitative" default-format="0.0%">
        <calculation class="tableau" formula="AVG([Discount])"/>
      </column>
