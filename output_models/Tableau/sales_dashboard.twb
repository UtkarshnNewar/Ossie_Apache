      <aliases enabled="yes"/>
      <column datatype="integer" name="[row_id]" role="dimension" type="nominal"/>
      <column datatype="string" name="[order_id]" role="dimension" type="nominal"/>
      <column datatype="datetime" name="[order_date]" role="dimension" type="ordinal"/>
      <column datatype="datetime" name="[ship_date]" role="dimension" type="ordinal"/>
      <column datatype="string" name="[ship_mode]" role="dimension" type="nominal"/>
      <column datatype="string" name="[customer_id]" role="dimension" type="nominal" caption="customer_id"/>
      <column datatype="string" name="[segment]" role="dimension" type="nominal"/>
      <column datatype="integer" name="[postal_code]" role="measure" type="quantitative"/>
      <column datatype="string" name="[product_id]" role="dimension" type="nominal" caption="product_id"/>
      <column datatype="real" name="[sales]" role="measure" type="quantitative" caption="sales"/>
      <column datatype="integer" name="[quantity]" role="measure" type="quantitative"/>
      <column datatype="real" name="[discount]" role="measure" type="quantitative"/>
      <column datatype="real" name="[profit]" role="measure" type="quantitative"/>
      <column datatype="string" name="[product_id (products)]" role="dimension" type="nominal" caption="product_id (products)"/>
      <column datatype="string" name="[category]" role="dimension" type="nominal"/>
      <column datatype="string" name="[sub_category]" role="dimension" type="nominal"/>
      <column datatype="string" name="[product_name]" role="dimension" type="nominal"/>
      <column datatype="string" name="[customer_id (customers)]" role="dimension" type="nominal" caption="customer_id (customers)"/>
      <column datatype="string" name="[customer_name]" role="dimension" type="nominal"/>
      <column caption="Current Year" datatype="integer" name="[Current Year]" role="measure" type="quantitative" default-format="0">
        <calculation class="tableau" formula="[Parameters].[Parameter 1]"/>
      </column>
      <column caption="Previous Year" datatype="integer" name="[Previous Year]" role="measure" type="quantitative" default-format="0">
        <calculation class="tableau" formula="[Parameters].[Parameter 1] - 1"/>
      </column>
      <column caption="CY Sales" datatype="real" name="[CY Sales]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM(IF YEAR([order_date]) = [Parameters].[Parameter 1] THEN [sales] ELSE 0 END)"/>
      </column>
      <column caption="PY Sales" datatype="real" name="[PY Sales]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM(IF YEAR([order_date]) = [Previous Year] THEN [sales] ELSE 0 END)"/>
      </column>
      <column caption="Pct Diff Sales" datatype="real" name="[Pct Diff Sales]" role="measure" type="quantitative" default-format="0.0%;-0.0%;-">
        <calculation class="tableau" formula="([CY Sales] - [PY Sales]) / ([PY Sales])"/>
      </column>
      <column caption="CY Profit" datatype="real" name="[CY Profit]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM(IF YEAR([order_date]) = [Parameters].[Parameter 1] THEN [profit] ELSE 0 END)"/>
      </column>
      <column caption="PY Profit" datatype="real" name="[PY Profit]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM(IF YEAR([order_date]) = [Previous Year] THEN [profit] ELSE 0 END)"/>
      </column>
      <column caption="Pct Diff Profit" datatype="real" name="[Pct Diff Profit]" role="measure" type="quantitative" default-format="0.0%;-0.0%;-">
        <calculation class="tableau" formula="([CY Profit] - [PY Profit]) / ([CY Profit])"/>
      </column>
      <column caption="CY Quantity" datatype="integer" name="[CY Quantity]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="SUM(IF YEAR([order_date]) = [Parameters].[Parameter 1] THEN [quantity] ELSE 0 END)"/>
      </column>
      <column caption="PY Quantity" datatype="integer" name="[PY Quantity]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="SUM(IF YEAR([order_date]) = [Previous Year] THEN [quantity] ELSE 0 END)"/>
      </column>
      <column caption="Pct Diff Quantity" datatype="real" name="[Pct Diff Quantity]" role="measure" type="quantitative" default-format="0.0%;-0.0%;-">
        <calculation class="tableau" formula="([CY Quantity] - [PY Quantity]) / ([PY Quantity])"/>
      </column>
      <column caption="CY Orders" datatype="integer" name="[CY Orders]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="COUNTD(IF YEAR([order_date]) = [Parameters].[Parameter 1] THEN [order_id] END)"/>
      </column>
      <column caption="PY Orders" datatype="integer" name="[PY Orders]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="COUNTD(IF YEAR([order_date]) = [Previous Year] THEN [order_id] END)"/>
      </column>
      <column caption="Pct Diff Orders" datatype="real" name="[Pct Diff Orders]" role="measure" type="quantitative" default-format="0.0%;-0.0%;-">
        <calculation class="tableau" formula="([CY Orders] - [PY Orders]) / ([PY Orders])"/>
      </column>
      <column caption="CY Customers" datatype="integer" name="[CY Customers]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="COUNTD(IF YEAR([order_date]) = [Parameters].[Parameter 1] THEN [customer_id] END)"/>
      </column>
      <column caption="PY Customers" datatype="integer" name="[PY Customers]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="COUNTD(IF YEAR([order_date]) = [Previous Year] THEN [customer_id] END)"/>
      </column>
      <column caption="Pct Diff Customers" datatype="real" name="[Pct Diff Customers]" role="measure" type="quantitative" default-format="0.0%;-0.0%;-">
        <calculation class="tableau" formula="([CY Customers] - [PY Customers]) / ([PY Customers])"/>
      </column>
      <column caption="CY Sales Per Customer" datatype="real" name="[CY Sales Per Customer]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="[CY Sales] / ([CY Customers])"/>
      </column>
      <column caption="PY Sales Per Customer" datatype="real" name="[PY Sales Per Customer]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="[PY Sales] / ([PY Customers])"/>
      </column>
      <column caption="Pct Diff Sales Per Customer" datatype="real" name="[Pct Diff Sales Per Customer]" role="measure" type="quantitative" default-format="0.0%;-0.0%;-">
        <calculation class="tableau" formula="([CY Sales Per Customer] - [PY Sales Per Customer]) / ([PY Sales Per Customer])"/>
      </column>
      <column caption="Orders Per Customer" datatype="real" name="[Orders Per Customer]" role="measure" type="quantitative" default-format="0.00">
        <calculation class="tableau" formula="[CY Orders] / ([CY Customers])"/>
      </column>
      <column caption="KPI CY Less PY" datatype="string" name="[KPI CY Less PY]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [CY Sales] &lt; [PY Sales] THEN &quot;●&quot; ELSE &quot;&quot; END"/>
      </column>
      <column caption="KPI Sales Avg" datatype="string" name="[KPI Sales Avg]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [CY Sales] &gt; WINDOW_AVG([CY Sales]) THEN &quot;Above&quot; ELSE &quot;Below&quot; END"/>
      </column>
      <column caption="KPI Profit Avg" datatype="string" name="[KPI Profit Avg]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [CY Profit] &gt; WINDOW_AVG([CY Profit]) THEN &quot;Above&quot; ELSE &quot;Below&quot; END"/>
      </column>
      <column caption="Min Max Sales" datatype="real" name="[Min Max Sales]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="IF SUM([sales]) = WINDOW_MIN(SUM([sales])) OR SUM([sales]) = WINDOW_MAX(SUM([sales])) THEN SUM([sales]) ELSE NULL END"/>
      </column>
      <column caption="Min Max Profit" datatype="real" name="[Min Max Profit]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="IF SUM([profit]) = WINDOW_MIN(SUM([profit])) OR SUM([profit]) = WINDOW_MAX(SUM([profit])) THEN SUM([profit]) ELSE NULL END"/>
      </column>
      <column caption="Min Max Quantity" datatype="integer" name="[Min Max Quantity]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="IF SUM([quantity]) = WINDOW_MIN(SUM([quantity])) OR SUM([quantity]) = WINDOW_MAX(SUM([quantity])) THEN SUM([quantity]) ELSE NULL END"/>
      </column>
      <column caption="Min Max Orders" datatype="integer" name="[Min Max Orders]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="IF COUNTD([order_id]) = WINDOW_MIN(COUNTD([order_id])) OR COUNTD([order_id]) = WINDOW_MAX(COUNTD([order_id])) THEN COUNTD([order_id]) ELSE NULL END"/>
      </column>
      <column caption="Min Max Customers" datatype="integer" name="[Min Max Customers]" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="IF COUNTD([customer_id]) = WINDOW_MIN(COUNTD([customer_id])) OR COUNTD([customer_id]) = WINDOW_MAX(COUNTD([customer_id])) THEN COUNTD([customer_id]) ELSE NULL END"/>
      </column>
      <column caption="Min Max Sales Per Customers" datatype="real" name="[Min Max Sales Per Customers]" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="IF (SUM([sales])/(COUNTD([customer_id]))) = WINDOW_MIN(SUM([sales])/(COUNTD([customer_id]))) OR (SUM([sales])/(COUNTD([customer_id]))) = WINDOW_MAX(SUM([sales])/(COUNTD([customer_id]))) THEN (SUM([sales])/(COUNTD([customer_id]))) ELSE NULL END"/>
      </column>
    </datasource>
  </datasources>
